; Engine configuration file.
; It's best edited using the editor UI and not directly,
; though editing is supported.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values

config_version=5

[application]

config/name="BroWarz"
config/description="Real-time networked peer-to-peer strategy game"
config/version="0.1.0"
run/main_scene="res://scenes/main_menu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://assets/icon.png"

[autoload]

GameManager="*res://scripts/autoload/game_manager.gd"
NetworkManager="*res://scripts/autoload/network_manager.gd"
ResourceManager="*res://scripts/autoload/resource_manager.gd"
SettingsManager="*res://scripts/autoload/settings_manager.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"

[rendering]

renderer/rendering_method="forward_plus"
